# Copy this file to .env (in this same folder) and fill in your real key.
# .env is gitignored — never commit your real key.

# Required: your Portkey API key, used for the chat agent's model calls.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: override the model the agent uses (defaults to gpt-5.6-luna if unset).
# MODEL_NAME=gpt-5.6-luna
